name:                aoc03
version:             0.1.0.0
-- synopsis:
-- description:
license:             GPL-3
author:              Miguel Negrao
maintainer:          miguel.negrao@friendlyvirus.org
-- copyright:
category:            Text
build-type:          Simple
extra-source-files:  ChangeLog.md
cabal-version:       2.0

library
  exposed-modules:    AoC
  hs-source-dirs:     src
  build-depends:      base >=4.9 && < 4.24,
                      errors, text, fmt, QuickCheck, megaparsec, pretty-simple, containers
  default-language:   Haskell2010

executable prog
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base >=4.9 && < 4.24,
                       text,
                       megaparsec,
                       aoc03
  default-language:    Haskell2010

test-suite test
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:       base >=4.9 && < 4.24,
                       text,
                       megaparsec,
                       tasty,
                       tasty-hunit,
                       aoc03
  default-language:    Haskell2010

benchmark bench
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      bench
  build-depends:       base >=4.9 && < 4.24,
                       text,
                       megaparsec,
                       tasty-bench,
                       aoc03
  default-language:    Haskell2010
