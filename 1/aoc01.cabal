name:                aoc01
version:             0.1.0.0
-- synopsis:
-- description:
license:             GPL-3
author:              Miguel Negrao
maintainer:          miguel.negrao@friendlyvirus.org
-- copyright:
category:            Text
build-type:          Simple
extra-source-files:  ChangeLog.md
cabal-version:       >=1.10

executable prog
  main-is:             Main.hs
  build-depends:       base >=4.9 && < 4.24,
                       text,
                       megaparsec,
                       aoc01
  default-language:    Haskell2010
  hs-source-dirs:      app

library
  exposed-modules:     AoC
  hs-source-dirs:      src
  build-depends:       base >=4.9 && < 4.24,
                       text,
                       megaparsec
  default-language:    Haskell2010

test-suite test
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  build-depends:       base >=4.9 && < 4.24,
                       text,
                       megaparsec,
                       tasty,
                       tasty-hunit,
                       aoc01
  default-language:    Haskell2010

benchmark bench
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      bench
  build-depends:       base >=4.9 && < 4.24,
                       text,
                       megaparsec,
                       tasty-bench,
                       aoc01
  default-language:    Haskell2010
